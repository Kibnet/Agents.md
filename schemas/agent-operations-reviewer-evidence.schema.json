{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controlled reviewer observation v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "reviewerFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "activationBindingHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtimeFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "hostIdentity": {
      "type": "string",
      "minLength": 1
    },
    "childSessionId": {
      "type": "string",
      "minLength": 1
    },
    "effectiveSandbox": {
      "const": "read-only"
    },
    "readSucceeded": {
      "type": "boolean"
    },
    "writeDenied": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "reviewerFingerprint",
    "activationBindingHash",
    "configHash",
    "runtimeFingerprint",
    "observedAtUtc",
    "hostIdentity",
    "childSessionId",
    "effectiveSandbox",
    "readSucceeded",
    "writeDenied"
  ]
}
